{
  "name": "BotConfig",
  "type": "object",
  "properties": {
    "system_prompt": {
      "type": "string",
      "title": "Instrucciones del bot (system prompt)"
    },
    "model": {
      "type": "string",
      "title": "Modelo de IA",
      "enum": [
        "automatic",
        "gemini_3_flash",
        "gpt_5_mini",
        "gpt_5_4",
        "claude_sonnet_4_6"
      ],
      "default": "automatic"
    },
    "bot_preview_limit": {
      "type": "number",
      "title": "Tope de mensajes de la demo del bot",
      "default": 20
    },
    "active": {
      "type": "boolean",
      "title": "Activo",
      "default": true
    }
  },
  "required": [
    "system_prompt"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}