{
  "name": "PracticeSettings",
  "type": "object",
  "properties": {
    "bot_objective_prompt": {
      "type": "string",
      "title": "Bot \u2014 Prompt de objetivo",
      "description": "Instrucciones sobre QU\u00c9 tiene que lograr el bot (agendar, preguntar servicio/d\u00eda/horario, etc). Vac\u00edo = usa el predeterminado de la plataforma."
    },
    "bot_assistant_name": {
      "type": "string",
      "title": "Bot \u2014 Nombre del asistente",
      "description": "Nombre propio del bot. Vac\u00edo = se presenta como la asistente virtual del consultorio, sin nombre propio."
    },
    "owner_display_name": {
      "type": "string",
      "title": "Tu nombre (uso interno)",
      "description": "Nombre de pila con el que te saluda el panel. Distinto de practice_name (el nombre del negocio que ven tus pacientes)."
    },
    "bot_tone_prompt": {
      "type": "string",
      "title": "Bot \u2014 Prompt de tono/personalidad",
      "description": "Instrucciones sobre C\u00d3MO tiene que hablar el bot (tono, formalidad, uso de emojis, etc). Vac\u00edo = usa el predeterminado de la plataforma."
    },
    "bot_response_delay_seconds": {
      "type": "number",
      "title": "Bot \u2014 Demora antes de responder (segundos)",
      "enum": [
        5,
        15,
        30,
        60
      ],
      "default": 15,
      "description": "Cu\u00e1nto espera el bot antes de mandar su respuesta por WhatsApp, para que no se sienta instant\u00e1neo/robotizado."
    },
    "professional_type": {
      "type": "string",
      "title": "Tipo de profesional",
      "enum": [
        "dentist",
        "psychologist",
        "doctor",
        "physiotherapist",
        "nutritionist",
        "dermatologist",
        "pediatrician",
        "gynecologist",
        "cardiologist",
        "ophthalmologist",
        "speech_therapist",
        "occupational_therapist",
        "podiatrist",
        "veterinarian",
        "other"
      ],
      "default": "dentist"
    },
    "practice_name": {
      "type": "string",
      "title": "Nombre del consultorio / profesional"
    },
    "specialty": {
      "type": "string",
      "title": "Especialidad"
    },
    "address": {
      "type": "string",
      "title": "Direcci\u00f3n"
    },
    "address_city": {
      "type": "string",
      "title": "Localidad"
    },
    "address_province": {
      "type": "string",
      "title": "Provincia"
    },
    "address_lat": {
      "type": "number",
      "title": "Latitud de la direcci\u00f3n"
    },
    "address_lng": {
      "type": "number",
      "title": "Longitud de la direcci\u00f3n"
    },
    "phone": {
      "type": "string",
      "title": "Tel\u00e9fono del consultorio"
    },
    "professional_email": {
      "type": "string",
      "title": "Email de contacto",
      "format": "email"
    },
    "instagram_url": {
      "type": "string",
      "title": "Instagram",
      "format": "url",
      "description": "Enlace a tu perfil de Instagram (se muestra en tu p\u00e1gina de reservas)"
    },
    "facebook_url": {
      "type": "string",
      "title": "Facebook",
      "format": "url",
      "description": "Enlace a tu p\u00e1gina de Facebook (se muestra en tu p\u00e1gina de reservas)"
    },
    "website_url": {
      "type": "string",
      "title": "Sitio web",
      "format": "url",
      "description": "Tu sitio web, si ten\u00e9s (se muestra en tu p\u00e1gina de reservas)"
    },
    "handle": {
      "type": "string",
      "title": "Usuario p\u00fablico (@)",
      "description": "Nombre \u00fanico para tu enlace de reservas, sin espacios ni @"
    },
    "photo_url": {
      "type": "string",
      "title": "Foto de perfil",
      "format": "url"
    },
    "avatar_url": {
      "type": "string",
      "title": "Foto de perfil personal (uso interno de la app, distinta de la de Pagina publica)",
      "format": "url"
    },
    "photo_align": {
      "type": "string",
      "title": "Alineacion de la foto de perfil",
      "enum": [
        "left",
        "center",
        "right"
      ],
      "default": "center"
    },
    "photo_frame": {
      "type": "string",
      "title": "Marco de la foto de perfil",
      "enum": [
        "circle",
        "rounded",
        "none"
      ],
      "default": "circle"
    },
    "cover_image_url": {
      "type": "string",
      "title": "Imagen de portada",
      "format": "url",
      "description": "Banner de fondo en la p\u00e1gina p\u00fablica, detr\u00e1s de la foto de perfil. Si no se carga, se usa el color/gradiente del tema."
    },
    "cover_align": {
      "type": "string",
      "title": "Alineacion de la imagen de portada",
      "enum": [
        "top",
        "center",
        "bottom"
      ],
      "default": "center"
    },
    "custom_bg_pattern": {
      "type": "string",
      "title": "Patron de fondo (tema Personalizado)",
      "enum": [
        "none",
        "nature",
        "waves",
        "mesh",
        "gradient"
      ],
      "default": "none"
    },
    "custom_bg_image_url": {
      "type": "string",
      "title": "Imagen de fondo adaptativa (tema Personalizado)",
      "format": "url"
    },
    "custom_bg_overlay_opacity": {
      "type": "number",
      "title": "Opacidad del overlay sobre el fondo",
      "default": 40
    },
    "custom_border_radius": {
      "type": "string",
      "title": "Redondeado de tarjetas/botones",
      "enum": [
        "none",
        "soft",
        "full"
      ],
      "default": "soft"
    },
    "custom_card_opacity": {
      "type": "number",
      "title": "Opacidad de las tarjetas",
      "default": 100
    },
    "custom_blur_enabled": {
      "type": "boolean",
      "title": "Efecto vidrio (blur) en tarjetas",
      "default": false
    },
    "page_color": {
      "type": "string",
      "title": "Color de la p\u00e1gina p\u00fablica",
      "default": "#0f172a"
    },
    "page_color_secondary": {
      "type": "string",
      "title": "Color secundario",
      "description": "Tarjetas secundarias, texto secundario, bordes."
    },
    "theme_preset": {
      "type": "string",
      "title": "Tema visual de la p\u00e1gina p\u00fablica",
      "enum": [
        "luxury_gold",
        "glassmorphism_premium",
        "warm_botanical",
        "clean_dark_tech",
        "minimal_light",
        "photo_focus",
        "custom"
      ],
      "default": "clean_dark_tech",
      "description": "Preset visual de la pagina publica y del editor de personalizacion."
    },
    "heading_font_override": {
      "type": "string",
      "title": "Tipografia de encabezado (anula la del tema)",
      "enum": [
        "default",
        "serif_elegant",
        "modern_sans",
        "geometric",
        "editorial"
      ],
      "default": "default"
    },
    "description": {
      "type": "string",
      "title": "Descripci\u00f3n / presentaci\u00f3n"
    },
    "published": {
      "type": "boolean",
      "title": "P\u00e1gina p\u00fablica publicada",
      "default": true
    },
    "google_calendar_connected": {
      "type": "boolean",
      "title": "Google Calendar conectado",
      "default": false
    },
    "whatsapp_connected": {
      "type": "boolean",
      "title": "WhatsApp conectado",
      "default": false
    },
    "whatsapp_connection_type": {
      "type": "string",
      "title": "Tipo de conexi\u00f3n de WhatsApp",
      "enum": [
        "qr",
        "official"
      ],
      "description": "qr = Evolution API self-hosted (r\u00e1pido, no oficial). official = Zernio/Meta (API oficial)."
    },
    "whatsapp_status": {
      "type": "string",
      "title": "Estado detallado de la conexi\u00f3n",
      "enum": [
        "disconnected",
        "connecting",
        "need_scan",
        "connected"
      ],
      "default": "disconnected"
    },
    "whatsapp_phone_number": {
      "type": "string",
      "title": "N\u00famero de WhatsApp conectado (gen\u00e9rico, cualquier tipo de conexi\u00f3n)"
    },
    "wasender_session_id": {
      "type": "string",
      "title": "[DEPRECADO] WasenderAPI \u2014 ID de sesi\u00f3n"
    },
    "wasender_api_key": {
      "type": "string",
      "title": "[DEPRECADO] WasenderAPI \u2014 API Key de la sesi\u00f3n (para enviar mensajes)"
    },
    "wasender_webhook_secret": {
      "type": "string",
      "title": "[DEPRECADO] WasenderAPI \u2014 Webhook Secret de la sesi\u00f3n"
    },
    "evolution_instance_name": {
      "type": "string",
      "title": "Evolution API \u2014 Nombre de instancia",
      "description": "Identificador \u00fanico de la instancia de WhatsApp de este profesional en Evolution API. Se genera autom\u00e1ticamente (a partir del ID del consultorio) al conectar por QR."
    },
    "evolution_webhook_secret": {
      "type": "string",
      "title": "Evolution API \u2014 Webhook secret",
      "description": "Secreto propio (generado por Kame, no por Evolution) que viaja en la URL del webhook para verificar que los mensajes entrantes realmente vienen de esa instancia."
    },
    "zernio_profile_id": {
      "type": "string",
      "title": "Zernio \u2014 Profile ID",
      "description": "Perfil de Zernio creado autom\u00e1ticamente para este profesional al iniciar la conexi\u00f3n de WhatsApp."
    },
    "zernio_account_id": {
      "type": "string",
      "title": "Zernio \u2014 Account ID",
      "description": "ID de la cuenta de WhatsApp conectada en Zernio para este profesional (se obtiene autom\u00e1ticamente al conectar)"
    },
    "zernio_phone": {
      "type": "string",
      "title": "N\u00famero de WhatsApp del profesional",
      "description": "N\u00famero que usa el profesional para recibir mensajes (con c\u00f3digo de pa\u00eds)"
    },
    "plan": {
      "type": "string",
      "title": "Plan",
      "enum": [
        "trial",
        "basic",
        "pro",
        "clinic"
      ],
      "default": "trial"
    },
    "trial_ends_at": {
      "type": "string",
      "format": "date-time",
      "title": "Fin del per\u00edodo de prueba"
    },
    "trial_origin": {
      "type": "string",
      "title": "Origen del trial",
      "enum": [
        "landing",
        "invitation"
      ],
      "default": "landing"
    },
    "invitation_code": {
      "type": "string",
      "title": "C\u00f3digo de invitaci\u00f3n usado"
    },
    "bot_preview_count": {
      "type": "number",
      "title": "Mensajes usados en la demo del bot",
      "default": 0
    },
    "suspended": {
      "type": "boolean",
      "title": "Cuenta suspendida",
      "default": false
    },
    "whatsapp_usage_count": {
      "type": "number",
      "title": "Conversaciones procesadas este per\u00edodo",
      "description": "Contador de conversaciones/turnos procesados por el bot de WhatsApp en el per\u00edodo de facturaci\u00f3n actual. Solo lo escribe el backend.",
      "default": 0
    },
    "whatsapp_usage_period_start": {
      "type": "string",
      "format": "date-time",
      "title": "Inicio del per\u00edodo de uso actual",
      "description": "Cuando se reinicia (mensualmente), whatsapp_usage_count vuelve a 0."
    },
    "whatsapp_addon_conversations": {
      "type": "number",
      "title": "Conversaciones extra de packs adicionales",
      "description": "Cupo comprado aparte del l\u00edmite del plan (packs +100/+250). Se descuenta antes de bloquear/avisar.",
      "default": 0
    },
    "whatsapp_usage_alert_90_sent": {
      "type": "boolean",
      "title": "Alerta de 90% ya enviada este per\u00edodo",
      "default": false
    },
    "whatsapp_usage_alert_95_sent": {
      "type": "boolean",
      "title": "Alerta de 95% ya enviada este per\u00edodo",
      "default": false
    },
    "whatsapp_usage_alert_100_sent": {
      "type": "boolean",
      "title": "Alerta de 100% ya enviada este per\u00edodo",
      "default": false
    },
    "mercadopago_subscription_id": {
      "type": "string",
      "title": "Mercado Pago \u2014 ID de suscripci\u00f3n",
      "description": "preapproval_id devuelto por Mercado Pago al crear la suscripci\u00f3n recurrente. Lo usa el webhook para identificar a qu\u00e9 consultorio corresponde cada notificaci\u00f3n de pago."
    },
    "plan_granted_by_admin": {
      "type": "boolean",
      "title": "Plan asignado manualmente por un admin (el sync automatico de Mercado Pago no lo toca)",
      "default": false
    },
    "mp_cancelled_by_admin": {
      "type": "boolean",
      "title": "Suscripcion cancelada por un admin (marca visual)",
      "default": false
    },
    "google_refresh_token": {
      "type": "string",
      "title": "Refresh token de Google (privado)"
    },
    "google_calendar_email": {
      "type": "string",
      "title": "Email de la cuenta de Google conectada (solo para mostrar)"
    },
    "google_sync_enabled": {
      "type": "boolean",
      "title": "Sincronizacion activa",
      "default": true
    }
  },
  "required": [
    "professional_type"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}