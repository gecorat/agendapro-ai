{
  "name": "Availability",
  "properties": {
    "date": {
      "format": "date",
      "title": "Fecha espec\u00edfica (para feriados/bloqueos)",
      "type": "string"
    },
    "day_of_week": {
      "title": "D\u00eda de la semana (0=domingo, 6=s\u00e1bado)",
      "type": "number"
    },
    "end_time": {
      "title": "Hora de fin (HH:mm)",
      "type": "string"
    },
    "label": {
      "title": "Etiqueta (ej. Feriado, Almuerzo)",
      "type": "string"
    },
    "practice_owner_id": {
      "title": "Consultorio al que pertenece este horario",
      "type": "string"
    },
    "professional_ref_id": {
      "title": "Profesional (vacio = horario del dueno de la cuenta)",
      "type": "string"
    },
    "start_time": {
      "title": "Hora de inicio (HH:mm)",
      "type": "string"
    },
    "type": {
      "default": "work",
      "enum": [
        "work",
        "break",
        "holiday",
        "block"
      ],
      "title": "Tipo",
      "type": "string"
    }
  },
  "required": [
    "day_of_week",
    "start_time",
    "end_time",
    "type"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.practice_owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.practice_owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {},
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.practice_owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  },
  "type": "object"
}