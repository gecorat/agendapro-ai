{
  "name": "ReviewRequest",
  "type": "object",
  "properties": {
    "patient_id": {
      "type": "string",
      "title": "Paciente"
    },
    "patient_name": {
      "type": "string",
      "title": "Nombre del paciente (desnormalizado)"
    },
    "patient_phone": {
      "type": "string",
      "title": "Tel\u00e9fono del paciente"
    },
    "patient_email": {
      "type": "string",
      "title": "Email del paciente (desnormalizado)",
      "format": "email"
    },
    "appointment_id": {
      "type": "string",
      "title": "Cita asociada"
    },
    "service_name": {
      "type": "string",
      "title": "Servicio"
    },
    "appointment_date": {
      "type": "string",
      "format": "date-time",
      "title": "Fecha de la cita"
    },
    "status": {
      "type": "string",
      "title": "Estado",
      "enum": [
        "pending",
        "sent",
        "received",
        "declined"
      ],
      "default": "pending"
    },
    "rating": {
      "type": "number",
      "title": "Calificaci\u00f3n recibida (1-5)"
    },
    "review_text": {
      "type": "string",
      "title": "Texto de la rese\u00f1a recibida"
    },
    "request_message": {
      "type": "string",
      "title": "Mensaje de solicitud (editable)",
      "description": "Mensaje que se env\u00eda al paciente pidi\u00e9ndole una rese\u00f1a"
    },
    "token": {
      "type": "string",
      "title": "Token de acceso",
      "description": "Token secreto incluido en el enlace p\u00fablico para verificar acceso"
    },
    "disabled": {
      "type": "boolean",
      "title": "Env\u00edo desactivado para este paciente",
      "default": false
    },
    "sent_at": {
      "type": "string",
      "format": "date-time",
      "title": "Enviada el"
    },
    "received_at": {
      "type": "string",
      "format": "date-time",
      "title": "Respondida el"
    },
    "google_review_url": {
      "type": "string",
      "title": "Enlace de rese\u00f1a de Google",
      "format": "url"
    },
    "professional_id": {
      "type": "string",
      "title": "Profesional titular"
    }
  },
  "required": [
    "patient_id",
    "status"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.professional_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.professional_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.professional_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.professional_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}