{
  "name": "PlatformConfig",
  "type": "object",
  "properties": {
    "mercadopago_access_token": {
      "type": "string",
      "title": "Mercado Pago \u2014 Access Token"
    },
    "mercadopago_public_key": {
      "type": "string",
      "title": "Mercado Pago \u2014 Public Key"
    },
    "zernio_api_key": {
      "type": "string",
      "title": "Zernio \u2014 API Key (proveedor de WhatsApp)"
    },
    "zernio_account_id": {
      "type": "string",
      "title": "Zernio \u2014 Account ID (cuenta por defecto)",
      "description": "Account ID de la cuenta de WhatsApp principal en Zernio. Cada profesional puede tener el suyo en su configuraci\u00f3n."
    },
    "zernio_webhook_secret": {
      "type": "string",
      "title": "Zernio \u2014 Webhook Secret",
      "description": "Secreto compartido para verificar la firma de los webhooks entrantes de Zernio. Configurarlo tambi\u00e9n en el dashboard de Zernio al crear el webhook."
    },
    "bot_preview_limit": {
      "type": "number",
      "title": "Tope de mensajes de la demo del bot",
      "default": 20
    }
  },
  "required": [],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}