{
  "description": "Env\u00eda recordatorios autom\u00e1ticos por email 3hs antes de cada cita confirmada (y 24hs antes tambi\u00e9n, si se reserv\u00f3 con al menos 48hs de anticipaci\u00f3n)",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "appointment_reminders",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "send_reminders": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "sendReminders"
          },
          "then": "end",
          "x-base44": {
            "title": "Enviar recordatorios",
            "description": "Citas en ventana de 3hs o 24hs (seg\u00fan margen de reserva)"
          }
        }
      }
    ]
  },
  "name": "Recordatorios de citas",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 * * * *",
      "one_time_date": null,
      "timezone": "America/Buenos_Aires",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  }
}