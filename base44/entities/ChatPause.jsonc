{
  "name": "ChatPause",
  "type": "object",
  "description": "Estado de pausa del bot por conversaci\u00f3n individual (profesional + tel\u00e9fono del paciente). Cuando est\u00e1 pausado, el bot no responde autom\u00e1ticamente a esa persona \u2014 el profesional atiende a mano desde la bandeja de Chats.",
  "properties": {
    "professional_id": {
      "type": "string",
      "title": "Profesional"
    },
    "phone": {
      "type": "string",
      "title": "Tel\u00e9fono (normalizado, sin +)"
    },
    "paused": {
      "type": "boolean",
      "title": "Pausado",
      "default": false
    }
  },
  "required": [
    "professional_id",
    "phone"
  ],
  "rls": {
    "read": {
      "professional_id": "{{user.id}}"
    },
    "create": {
      "professional_id": "{{user.id}}"
    },
    "update": {
      "professional_id": "{{user.id}}"
    },
    "delete": {
      "professional_id": "{{user.id}}"
    }
  }
}