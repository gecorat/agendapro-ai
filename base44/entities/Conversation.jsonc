{
  "name": "Conversation",
  "type": "object",
  "properties": {
    "phone": {
      "type": "string",
      "title": "Teléfono del paciente"
    },
    "professional_id": {
      "type": "string",
      "title": "Profesional titular"
    },
    "role": {
      "type": "string",
      "title": "Rol",
      "enum": [
        "user",
        "assistant"
      ]
    },
    "text": {
      "type": "string",
      "title": "Mensaje"
    },
    "conversation_id": {
      "type": "string",
      "title": "ID de conversación en Zernio"
    },
    "account_id": {
      "type": "string",
      "title": "Account ID de Zernio"
    },
    "delivery_failed": {
      "type": "boolean",
      "title": "El envío por WhatsApp falló tras reintentos",
      "default": false
    },
    "wasender_msg_id": {
      "type": "string",
      "title": "ID del mensaje en WasenderAPI (para cruzar con la confirmacion real de entrega)"
    },
    "sent_by": {
      "type": "string",
      "title": "Quien mando este mensaje",
      "enum": [
        "bot",
        "human"
      ],
      "default": "bot"
    }
  },
  "required": [
    "phone",
    "role",
    "text"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.professional_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {},
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.professional_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.professional_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}