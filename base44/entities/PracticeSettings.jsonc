{
  "name": "PracticeSettings",
  "type": "object",
  "properties": {
    "professional_type": {
      "type": "string",
      "title": "Tipo de profesional",
      "enum": [
        "dentist",
        "psychologist",
        "doctor",
        "physiotherapist",
        "nutritionist",
        "dermatologist",
        "pediatrician",
        "gynecologist",
        "cardiologist",
        "ophthalmologist",
        "speech_therapist",
        "occupational_therapist",
        "podiatrist",
        "veterinarian",
        "other"
      ],
      "default": "dentist"
    },
    "practice_name": {
      "type": "string",
      "title": "Nombre del consultorio / profesional"
    },
    "specialty": {
      "type": "string",
      "title": "Especialidad"
    },
    "address": {
      "type": "string",
      "title": "Dirección"
    },
    "address_city": {
      "type": "string",
      "title": "Localidad"
    },
    "address_province": {
      "type": "string",
      "title": "Provincia"
    },
    "address_lat": {
      "type": "number",
      "title": "Latitud de la dirección"
    },
    "address_lng": {
      "type": "number",
      "title": "Longitud de la dirección"
    },
    "phone": {
      "type": "string",
      "title": "Teléfono del consultorio"
    },
    "professional_email": {
      "type": "string",
      "title": "Email de contacto",
      "format": "email"
    },
    "instagram_url": {
      "type": "string",
      "title": "Instagram",
      "format": "url",
      "description": "Enlace a tu perfil de Instagram (se muestra en tu página de reservas)"
    },
    "facebook_url": {
      "type": "string",
      "title": "Facebook",
      "format": "url",
      "description": "Enlace a tu página de Facebook (se muestra en tu página de reservas)"
    },
    "website_url": {
      "type": "string",
      "title": "Sitio web",
      "format": "url",
      "description": "Tu sitio web, si tenés (se muestra en tu página de reservas)"
    },
    "handle": {
      "type": "string",
      "title": "Usuario público (@)",
      "description": "Nombre único para tu enlace de reservas, sin espacios ni @"
    },
    "photo_url": {
      "type": "string",
      "title": "Foto de perfil",
      "format": "url"
    },
    "photo_align": {
      "type": "string",
      "title": "Alineacion de la foto de perfil",
      "enum": [
        "left",
        "center",
        "right"
      ],
      "default": "center"
    },
    "photo_frame": {
      "type": "string",
      "title": "Marco de la foto de perfil",
      "enum": [
        "circle",
        "rounded",
        "none"
      ],
      "default": "circle"
    },
    "cover_image_url": {
      "type": "string",
      "title": "Imagen de portada",
      "format": "url",
      "description": "Banner de fondo en la página pública, detrás de la foto de perfil. Si no se carga, se usa el color/gradiente del tema."
    },
    "cover_align": {
      "type": "string",
      "title": "Alineacion de la imagen de portada",
      "enum": [
        "top",
        "center",
        "bottom"
      ],
      "default": "center"
    },
    "custom_bg_pattern": {
      "type": "string",
      "title": "Patron de fondo (tema Personalizado)",
      "enum": [
        "none",
        "nature",
        "waves",
        "mesh",
        "gradient"
      ],
      "default": "none"
    },
    "custom_bg_image_url": {
      "type": "string",
      "title": "Imagen de fondo adaptativa (tema Personalizado)",
      "format": "url"
    },
    "custom_bg_overlay_opacity": {
      "type": "number",
      "title": "Opacidad del overlay sobre el fondo",
      "default": 40
    },
    "custom_border_radius": {
      "type": "string",
      "title": "Redondeado de tarjetas/botones",
      "enum": [
        "none",
        "soft",
        "full"
      ],
      "default": "soft"
    },
    "custom_card_opacity": {
      "type": "number",
      "title": "Opacidad de las tarjetas",
      "default": 100
    },
    "custom_blur_enabled": {
      "type": "boolean",
      "title": "Efecto vidrio (blur) en tarjetas",
      "default": false
    },
    "page_color": {
      "type": "string",
      "title": "Color de la página pública",
      "default": "#0f172a"
    },
    "page_color_secondary": {
      "type": "string",
      "title": "Color secundario",
      "description": "Tarjetas secundarias, texto secundario, bordes."
    },
    "theme_preset": {
      "type": "string",
      "title": "Tema visual de la página pública",
      "enum": [
        "luxury_gold",
        "glassmorphism_premium",
        "warm_botanical",
        "clean_dark_tech",
        "minimal_light",
        "photo_focus",
        "custom"
      ],
      "default": "clean_dark_tech",
      "description": "Preset visual de la pagina publica y del editor de personalizacion."
    },
    "heading_font_override": {
      "type": "string",
      "title": "Tipografia de encabezado (anula la del tema)",
      "enum": [
        "default",
        "serif_elegant",
        "modern_sans",
        "geometric",
        "editorial"
      ],
      "default": "default"
    },
    "description": {
      "type": "string",
      "title": "Descripción / presentación"
    },
    "published": {
      "type": "boolean",
      "title": "Página pública publicada",
      "default": true
    },
    "google_calendar_connected": {
      "type": "boolean",
      "title": "Google Calendar conectado",
      "default": false
    },
    "whatsapp_connected": {
      "type": "boolean",
      "title": "WhatsApp conectado",
      "default": false
    },
    "whatsapp_connection_type": {
      "type": "string",
      "title": "Tipo de conexión de WhatsApp",
      "enum": [
        "qr",
        "official"
      ],
      "description": "qr = WasenderAPI (rápido, no oficial). official = Zernio/Meta (API oficial)."
    },
    "whatsapp_status": {
      "type": "string",
      "title": "Estado detallado de la conexión",
      "enum": [
        "disconnected",
        "connecting",
        "need_scan",
        "connected"
      ],
      "default": "disconnected"
    },
    "whatsapp_phone_number": {
      "type": "string",
      "title": "Número de WhatsApp conectado (genérico, cualquier tipo de conexión)"
    },
    "wasender_session_id": {
      "type": "string",
      "title": "WasenderAPI — ID de sesión"
    },
    "wasender_api_key": {
      "type": "string",
      "title": "WasenderAPI — API Key de la sesión (para enviar mensajes)"
    },
    "wasender_webhook_secret": {
      "type": "string",
      "title": "WasenderAPI — Webhook Secret de la sesión"
    },
    "zernio_profile_id": {
      "type": "string",
      "title": "Zernio — Profile ID",
      "description": "Perfil de Zernio creado automáticamente para este profesional al iniciar la conexión de WhatsApp."
    },
    "zernio_account_id": {
      "type": "string",
      "title": "Zernio — Account ID",
      "description": "ID de la cuenta de WhatsApp conectada en Zernio para este profesional (se obtiene automáticamente al conectar)"
    },
    "zernio_phone": {
      "type": "string",
      "title": "Número de WhatsApp del profesional",
      "description": "Número que usa el profesional para recibir mensajes (con código de país)"
    },
    "plan": {
      "type": "string",
      "title": "Plan",
      "enum": [
        "trial",
        "basic",
        "pro",
        "clinic"
      ],
      "default": "trial"
    },
    "trial_ends_at": {
      "type": "string",
      "format": "date-time",
      "title": "Fin del período de prueba"
    },
    "trial_origin": {
      "type": "string",
      "title": "Origen del trial",
      "enum": [
        "landing",
        "invitation"
      ],
      "default": "landing"
    },
    "invitation_code": {
      "type": "string",
      "title": "Código de invitación usado"
    },
    "bot_preview_count": {
      "type": "number",
      "title": "Mensajes usados en la demo del bot",
      "default": 0
    },
    "suspended": {
      "type": "boolean",
      "title": "Cuenta suspendida",
      "default": false
    },
    "whatsapp_usage_count": {
      "type": "number",
      "title": "Conversaciones procesadas este período",
      "description": "Contador de conversaciones/turnos procesados por el bot de WhatsApp en el período de facturación actual. Solo lo escribe el backend.",
      "default": 0
    },
    "whatsapp_usage_period_start": {
      "type": "string",
      "format": "date-time",
      "title": "Inicio del período de uso actual",
      "description": "Cuando se reinicia (mensualmente), whatsapp_usage_count vuelve a 0."
    },
    "whatsapp_addon_conversations": {
      "type": "number",
      "title": "Conversaciones extra de packs adicionales",
      "description": "Cupo comprado aparte del límite del plan (packs +100/+250). Se descuenta antes de bloquear/avisar.",
      "default": 0
    },
    "whatsapp_usage_alert_90_sent": {
      "type": "boolean",
      "title": "Alerta de 90% ya enviada este período",
      "default": false
    },
    "whatsapp_usage_alert_95_sent": {
      "type": "boolean",
      "title": "Alerta de 95% ya enviada este período",
      "default": false
    },
    "whatsapp_usage_alert_100_sent": {
      "type": "boolean",
      "title": "Alerta de 100% ya enviada este período",
      "default": false
    },
    "mercadopago_subscription_id": {
      "type": "string",
      "title": "Mercado Pago — ID de suscripción",
      "description": "preapproval_id devuelto por Mercado Pago al crear la suscripción recurrente. Lo usa el webhook para identificar a qué consultorio corresponde cada notificación de pago."
    },
    "plan_granted_by_admin": {
      "type": "boolean",
      "title": "Plan asignado manualmente por un admin (el sync automatico de Mercado Pago no lo toca)",
      "default": false
    }
  },
  "required": [
    "professional_type"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}