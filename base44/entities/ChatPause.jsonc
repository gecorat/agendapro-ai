{
  "name": "ChatPause",
  "type": "object",
  "description": "Estado de pausa del bot por conversación individual (profesional + teléfono del paciente). Cuando está pausado, el bot no responde automáticamente a esa persona — el profesional atiende a mano desde la bandeja de Chats.",
  "properties": {
    "professional_id": {
      "type": "string",
      "title": "Profesional"
    },
    "phone": {
      "type": "string",
      "title": "Teléfono (normalizado, sin +)"
    },
    "paused": {
      "type": "boolean",
      "title": "Pausado",
      "default": false
    },
    "paused_until": {
      "type": "string",
      "format": "date-time",
      "title": "Pausado hasta (vacio = indefinido)"
    }
  },
  "required": [
    "professional_id",
    "phone"
  ],
  "rls": {
    "read": {
      "professional_id": "{{user.id}}"
    },
    "create": {
      "professional_id": "{{user.id}}"
    },
    "update": {
      "professional_id": "{{user.id}}"
    },
    "delete": {
      "professional_id": "{{user.id}}"
    }
  }
}