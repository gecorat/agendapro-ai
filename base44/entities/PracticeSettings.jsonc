{
  "name": "PracticeSettings",
  "type": "object",
  "properties": {
    "professional_type": {
      "type": "string",
      "title": "Tipo de profesional",
      "enum": [
        "dentist",
        "psychologist",
        "doctor",
        "physiotherapist",
        "nutritionist",
        "other"
      ],
      "default": "dentist"
    },
    "practice_name": {
      "type": "string",
      "title": "Nombre del consultorio / profesional"
    },
    "specialty": {
      "type": "string",
      "title": "Especialidad"
    },
    "address": {
      "type": "string",
      "title": "Direcci\u00f3n"
    },
    "phone": {
      "type": "string",
      "title": "Tel\u00e9fono del consultorio"
    },
    "professional_email": {
      "type": "string",
      "title": "Email de contacto",
      "format": "email"
    },
    "handle": {
      "type": "string",
      "title": "Usuario p\u00fablico (@)",
      "description": "Nombre \u00fanico para tu enlace de reservas, sin espacios ni @"
    },
    "photo_url": {
      "type": "string",
      "title": "Foto de perfil",
      "format": "url"
    },
    "page_color": {
      "type": "string",
      "title": "Color de la p\u00e1gina p\u00fablica",
      "default": "#0f172a"
    },
    "description": {
      "type": "string",
      "title": "Descripci\u00f3n / presentaci\u00f3n"
    },
    "published": {
      "type": "boolean",
      "title": "P\u00e1gina p\u00fablica publicada",
      "default": true
    },
    "google_calendar_connected": {
      "type": "boolean",
      "title": "Google Calendar conectado",
      "default": false
    },
    "whatsapp_connected": {
      "type": "boolean",
      "title": "WhatsApp conectado",
      "default": false
    },
    "plan": {
      "type": "string",
      "title": "Plan",
      "enum": [
        "trial",
        "pro",
        "premium"
      ],
      "default": "trial"
    },
    "trial_ends_at": {
      "type": "string",
      "format": "date-time",
      "title": "Fin del per\u00edodo de prueba"
    },
    "trial_origin": {
      "type": "string",
      "title": "Origen del trial",
      "enum": [
        "landing",
        "invitation"
      ],
      "default": "landing"
    },
    "invitation_code": {
      "type": "string",
      "title": "C\u00f3digo de invitaci\u00f3n usado"
    },
    "bot_preview_count": {
      "type": "number",
      "title": "Mensajes usados en la demo del bot",
      "default": 0
    },
    "suspended": {
      "type": "boolean",
      "title": "Cuenta suspendida",
      "default": false
    }
  },
  "required": [
    "professional_type"
  ],
  "rls": {
    "read": {},
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}