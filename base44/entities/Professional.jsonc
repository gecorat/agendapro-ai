{
  "name": "Professional",
  "type": "object",
  "description": "Un profesional dentro de un consultorio con plan Clinic (hasta 3, con opci\u00f3n de sumar m\u00e1s). El due\u00f1o de la cuenta (PracticeSettings.created_by_id) es siempre el primer profesional impl\u00edcito; los dem\u00e1s se agregan ac\u00e1.",
  "properties": {
    "practice_owner_id": {
      "type": "string",
      "title": "Consultorio (owner)",
      "description": "created_by_id del PracticeSettings al que pertenece este profesional."
    },
    "first_name": {
      "type": "string",
      "title": "Nombre"
    },
    "last_name": {
      "type": "string",
      "title": "Apellido"
    },
    "specialty": {
      "type": "string",
      "title": "Especialidad / rol",
      "description": "Lo que el paciente ve al elegir con qui\u00e9n quiere agendar por WhatsApp o en la p\u00e1gina p\u00fablica."
    },
    "photo_url": {
      "type": "string",
      "title": "Foto",
      "format": "url"
    },
    "color": {
      "type": "string",
      "title": "Color en la agenda",
      "default": "#3b82f6"
    },
    "active": {
      "type": "boolean",
      "title": "Activo",
      "description": "Si est\u00e1 inactivo, no se ofrece como opci\u00f3n para agendar (ej. de licencia).",
      "default": true
    },
    "is_owner": {
      "type": "boolean",
      "title": "Es el due\u00f1o de la cuenta",
      "description": "true para el registro que representa al propio profesional due\u00f1o del PracticeSettings (se crea autom\u00e1ticamente al pasar a plan Clinic).",
      "default": false
    },
    "email": {
      "type": "string",
      "title": "Email (para invitar)",
      "format": "email"
    },
    "invite_token": {
      "type": "string",
      "title": "Token de invitacion unico"
    },
    "invite_status": {
      "type": "string",
      "title": "Estado de la invitacion",
      "enum": [
        "none",
        "pending",
        "accepted"
      ],
      "default": "none"
    },
    "user_id": {
      "type": "string",
      "title": "Usuario Base44 asociado (una vez que acepta la invitacion)"
    },
    "is_paid_addon": {
      "type": "boolean",
      "title": "Cuenta como profesional extra pago (mas alla de los 3 incluidos)",
      "default": false
    },
    "is_team_admin": {
      "type": "boolean",
      "title": "Co-admin del consultorio (todo menos facturacion/plan)",
      "default": false
    },
    "google_calendar_connected": {
      "type": "boolean",
      "title": "Google Calendar conectado",
      "default": false
    },
    "google_calendar_email": {
      "type": "string",
      "title": "Email de la cuenta de Google conectada (solo para mostrar)"
    },
    "google_sync_enabled": {
      "type": "boolean",
      "title": "Sincronizacion activa",
      "default": true
    }
  },
  "required": [
    "practice_owner_id",
    "first_name"
  ],
  "rls": {
    "read": {},
    "create": {
      "$or": [
        {
          "data.practice_owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.practice_owner_id": "{{user.id}}"
        },
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.practice_owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}