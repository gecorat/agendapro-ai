{
  "description": "Registro de cada aviso enviado (o intentado) a un paciente. Es la fuente de verdad para el historial que se muestra en la Agenda y para diagnosticar por que un aviso no llego: antes, si el envio por WhatsApp fallaba, el error solo quedaba en un console.error que nadie miraba.",
  "name": "NotificationLog",
  "properties": {
    "appointment_id": {
      "title": "Cita",
      "type": "string"
    },
    "channel": {
      "enum": [
        "whatsapp",
        "email"
      ],
      "title": "Canal",
      "type": "string"
    },
    "error": {
      "title": "Detalle del error, si fallo",
      "type": "string"
    },
    "kind": {
      "enum": [
        "confirmation",
        "pending",
        "reminder_24h",
        "reminder_3h",
        "rescheduled",
        "cancelled"
      ],
      "title": "Tipo de aviso",
      "type": "string"
    },
    "patient_id": {
      "title": "Paciente",
      "type": "string"
    },
    "professional_id": {
      "title": "Consultorio (dueno de la cuenta)",
      "type": "string"
    },
    "sent_at": {
      "format": "date-time",
      "title": "Momento del envio",
      "type": "string"
    },
    "status": {
      "enum": [
        "sent",
        "failed",
        "skipped"
      ],
      "title": "Resultado",
      "type": "string"
    },
    "to": {
      "title": "Destino (telefono o email)",
      "type": "string"
    }
  },
  "required": [
    "kind",
    "channel",
    "status"
  ],
  "type": "object",
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.professional_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {},
    "update": {
      "$or": [
        {
          "data.professional_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.professional_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}