{
  "description": "Secretos/credenciales del consultorio (PracticeSettings), separados en una entidad aparte y cerrada al cliente para que nunca queden expuestos por un RLS de lectura p\u00fablica en PracticeSettings (que s\u00ed necesita ser p\u00fablico para la p\u00e1gina de reservas). Solo lo tocan funciones de backend con asServiceRole.",
  "name": "PracticeSecrets",
  "properties": {
    "evolution_webhook_secret": {
      "title": "Evolution API \u2014 Webhook secret",
      "type": "string"
    },
    "google_refresh_token": {
      "title": "Refresh token de Google (privado)",
      "type": "string"
    },
    "practice_id": {
      "title": "PracticeSettings.id al que pertenece",
      "type": "string"
    },
    "wasender_api_key": {
      "title": "[DEPRECADO] WasenderAPI \u2014 API Key",
      "type": "string"
    },
    "wasender_webhook_secret": {
      "title": "[DEPRECADO] WasenderAPI \u2014 Webhook Secret",
      "type": "string"
    }
  },
  "required": [
    "practice_id"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "type": "object"
}