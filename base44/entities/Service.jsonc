{
  "name": "Service",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Nombre del servicio"
    },
    "description": {
      "type": "string",
      "title": "Descripci\u00f3n"
    },
    "prep_notes": {
      "type": "string",
      "title": "Notas de preparaci\u00f3n para el paciente",
      "description": "Indicaciones que el paciente debe seguir antes de la consulta (ayuno, radiograf\u00edas, etc.)"
    },
    "duration_minutes": {
      "type": "number",
      "title": "Duraci\u00f3n (minutos)",
      "default": 30
    },
    "margin_minutes": {
      "type": "number",
      "title": "Margen entre citas (minutos)",
      "default": 0
    },
    "color": {
      "type": "string",
      "title": "Color para la agenda",
      "default": "#3b82f6"
    },
    "price": {
      "type": "number",
      "title": "Precio (opcional)"
    },
    "follow_up_days": {
      "type": "number",
      "title": "D\u00edas para seguimiento/recordatorio de control",
      "default": 0
    },
    "active": {
      "type": "boolean",
      "title": "Activo",
      "default": true
    },
    "professional_ref_id": {
      "type": "string",
      "title": "Profesional (plan Clinic)",
      "description": "ID de Professional al que pertenece este servicio. Vac\u00edo = lo ofrece el due\u00f1o de la cuenta (comportamiento normal en planes Base/Pro)."
    },
    "practice_owner_id": {
      "type": "string",
      "title": "Consultorio al que pertenece",
      "description": "Id del usuario due\u00f1o del consultorio. Mismo criterio y mismo nombre que en Availability. Reemplaza a created_by_id, que Base44 estampa con quien ejecuta el create: los servicios creados por el onboarding con rol de servicio quedaban todos con el mismo id de servicio y se mezclaban entre cuentas distintas (ver base44/shared/ownership.ts). Vac\u00edo en los servicios anteriores al 3/9/2026, que resuelven por created_by_id como respaldo."
    }
  },
  "required": [
    "name",
    "duration_minutes"
  ],
  "rls": {
    "read": {},
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}