{
  "name": "PlatformConfig",
  "type": "object",
  "properties": {
    "app_base_url": {
      "type": "string",
      "title": "URL p\u00fablica de la app",
      "description": "Dominio p\u00fablico donde est\u00e1 publicada la app (ej. https://agendate.base44.app). Se usa para construir los enlaces de confirmaci\u00f3n/cancelaci\u00f3n/reagendar en los emails.",
      "format": "url"
    },
    "mercadopago_access_token": {
      "type": "string",
      "title": "Mercado Pago \u2014 Access Token"
    },
    "mercadopago_public_key": {
      "type": "string",
      "title": "Mercado Pago \u2014 Public Key"
    },
    "zernio_api_key": {
      "type": "string",
      "title": "Zernio \u2014 API Key (proveedor de WhatsApp)"
    },
    "zernio_account_id": {
      "type": "string",
      "title": "Zernio \u2014 Account ID (cuenta por defecto)",
      "description": "Account ID de la cuenta de WhatsApp principal en Zernio. Cada profesional puede tener el suyo en su configuraci\u00f3n."
    },
    "zernio_webhook_secret": {
      "type": "string",
      "title": "Zernio \u2014 Webhook Secret",
      "description": "Secreto compartido para verificar la firma de los webhooks entrantes de Zernio. Configurarlo tambi\u00e9n en el dashboard de Zernio al crear el webhook."
    },
    "bot_preview_limit": {
      "type": "number",
      "title": "Tope de mensajes de la demo del bot",
      "default": 20
    },
    "google_maps_api_key": {
      "type": "string",
      "title": "Google Maps / Places \u2014 API Key",
      "description": "Habilita el autocompletado de direcciones en el perfil y el mapa embebido en la p\u00e1gina p\u00fablica. Sin esto, ambos siguen funcionando en modo b\u00e1sico (texto libre / mapa sin key)."
    },
    "wasender_personal_access_token": {
      "type": "string",
      "title": "[DEPRECADO] WasenderAPI \u2014 Personal Access Token",
      "description": "Ya no se usa: la conexi\u00f3n por QR ahora corre sobre Evolution API (self-hosted). Se deja el campo sin borrar por compatibilidad hacia atr\u00e1s, pero el c\u00f3digo nuevo no lo lee."
    },
    "evolution_base_url": {
      "type": "string",
      "title": "Evolution API \u2014 Base URL",
      "description": "URL de tu instancia de Evolution API self-hosted, sin barra al final (ej: https://evolution.tudominio.com). Habilita la opci\u00f3n de conectar WhatsApp por QR."
    },
    "evolution_api_key": {
      "type": "string",
      "title": "Evolution API \u2014 Global API Key",
      "description": "La API Key global configurada en el .env de tu Evolution API (AUTHENTICATION_API_KEY). Se usa para crear y administrar la instancia de WhatsApp de cada profesional."
    },
    "debug_last_webhook_payload": {
      "type": "string",
      "title": "Debug: \u00faltimo payload crudo de Zernio",
      "description": "Temporal, para diagnosticar el formato real de los webhooks de Zernio. Se puede borrar una vez resuelto."
    },
    "google_client_id": {
      "type": "string",
      "title": "Google OAuth Client ID"
    },
    "google_client_secret": {
      "type": "string",
      "title": "Google OAuth Client Secret"
    }
  },
  "required": [],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}