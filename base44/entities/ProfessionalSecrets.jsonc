{
  "description": "Secretos/credenciales de un Professional individual (equipo del plan Clinic), separados en una entidad aparte y cerrada al cliente por el mismo motivo que PracticeSecrets: Professional necesita read p\u00fablico para la p\u00e1gina de reservas, y este token no puede viajar ah\u00ed. Solo lo tocan funciones de backend con asServiceRole.",
  "name": "ProfessionalSecrets",
  "properties": {
    "google_refresh_token": {
      "title": "Refresh token de Google (privado)",
      "type": "string"
    },
    "professional_id": {
      "title": "Professional.id al que pertenece",
      "type": "string"
    }
  },
  "required": [
    "professional_id"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "type": "object"
}